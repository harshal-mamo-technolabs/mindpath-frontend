# Copy to .env and fill in. Vars must be prefixed with VITE_ to reach the client.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Stripe publishable key (pk_...) from Stripe Dashboard → Developers → API keys.
# The secret key (sk_...) must stay on the backend only.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Billing mode: "stripe" (subscriptions + pay-as-you-go) or "msisdn" (carrier
# billing — hides all card/Stripe UI; no pay-as-you-go fallback). Defaults to stripe.
VITE_BILLING_MODE=stripe

# Application name. Shown everywhere the brand appears (logo, copy in all four
# languages, tab title, push notifications, ebook imprint). Change it here and the
# whole app rebrands — restart the dev server / rebuild to pick it up.
VITE_APP_NAME=MindPath
